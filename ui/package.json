{
    "name": "disenuio",
    "private": true,
    "version": "0.0.0",
    "description": "Reusable, performant React components",
    "license": "MIT",
    "author": "Izyne Gallardo",
    "type": "module",
    "sideEffects": [
        "**/*.css"
    ],
    "files": [
        "dist"
    ],
    "exports": {
        ".": "./dist/disenuio.js",
        "./style.css": "./dist/style.css"
    },
    "publishConfig": {
        "access": "public"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/izynegallardo/disenuio.git",
        "directory": "ui"
    },
    "bugs": {
        "url": "https://github.com/izynegallardo/disenuio/issues"
    },
    "homepage": "https://github.com/izynegallardo/disenuio#readme",
    "keywords": [
        "react",
        "components",
        "ui"
    ],
    "scripts": {
        "dev": "vite build --watch",
        "build": "vite build",
        "lint": "oxlint",
        "test": "vitest run",
        "test:watch": "vitest",
        "prepublishOnly": "npm run build",
        "preview": "vite preview"
    },
    "devDependencies": {
        "@testing-library/dom": "^10.4.2",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.8",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.2",
        "jsdom": "^29.1.1",
        "oxlint": "^1.88.0",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "vite": "^8.3.4",
        "vitest": "^4.1.12"
    },
    "peerDependencies": {
        "react": "^19.0.0",
        "react-dom": "^19.0.0"
    }
}
